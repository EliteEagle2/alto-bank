@model List<NewsArticle>
@{
    ViewData["Title"] = "Newsroom";
}

<partial name="_PageHero" model='new PageHeroViewModel("Newsroom", "News from Alto.",
    "Product launches, company updates, and announcements.")' />

<div class="container">
    <div class="row g-4">
        @foreach (var article in Model)
        {
            <div class="col-md-6 col-lg-4"><partial name="_NewsCard" model="article" /></div>
        }
    </div>

    <div class="glass p-4 mt-5 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h5 class="mb-1">Media inquiries</h5>
            <p class="text-muted-alto mb-0">Members of the press can reach our communications team any time.</p>
        </div>
        <a class="btn btn-alto-outline" asp-controller="Support" asp-action="Contact" asp-route-topic="Press">Contact press team</a>
    </div>
</div>
