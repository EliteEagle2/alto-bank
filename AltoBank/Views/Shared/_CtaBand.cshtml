@model CtaViewModel
@* Gradient "call to action" band shown near the bottom of public pages. *@
<div class="cta-band text-center">
    <h2 class="section-title mb-3">@Model.Title</h2>
    <p class="text-muted-alto mb-4">@Model.Text</p>
    <a class="btn btn-alto btn-lg" asp-controller="@Model.Controller" asp-action="@Model.Action">@Model.ButtonText</a>
</div>
