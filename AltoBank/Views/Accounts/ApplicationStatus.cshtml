@model AccountApplication
@{
    Layout = "_ApplyLayout";
    ViewData["IsDecision"] = true;
    var pending = Model.Status == ApplicationStatus.Pending;
    ViewData["Title"] = pending ? "Application under review" : "Application decision";
    var isLoan = Model.AccountType == AccountType.Loan;
    var isCard = Model.AccountType == AccountType.CreditCard || isLoan;   // a credit decision: show the demo note
    var product = Model.AccountType switch { AccountType.Checking => "Alto Checking", AccountType.Savings => "Summit Savings", AccountType.Loan => $"{Model.LoanKind} loan", _ => "Alto Peak Card" };
    var declined = Model.Status == ApplicationStatus.OfferDeclined;
}

<div class="apply-grid decision" id="decision" data-animate="false" data-user-key="@Model.UserId">
    <aside class="apply-aside">
        <partial name="_ApplicationStepNav" model="8" />
    </aside>

    <section class="apply-main">
        <div class="glass reviewing @(pending || declined ? "" : "denied")">
            @if (pending)
            {
                @* Pending: an admin has to approve it (Settings → "Auto-approve applications" is OFF). *@
                <div class="orbit" aria-hidden="true"><span></span><span></span><span></span></div>
                <h1 class="h3 mt-4 mb-2">We're reviewing your application</h1>
                <p class="text-muted-alto mb-4">
                    Thanks, @Model.FirstName! A member of our team is looking over your @product application.
                    Most reviews finish within one business day. We'll show the decision on your Profile page.
                </p>
                @if (isCard)
                {
                    <p class="small text-muted-alto mb-3">@(Model.DecisionNote ?? "")</p>
                    <div class="mb-4"><span class="demo-note">Demo decision, no credit check</span></div>
                }
            }
            else if (declined)
            {
                <h1 class="h3 mt-2 mb-2">You declined this loan offer</h1>
                <p class="text-muted-alto mb-4">Nothing was borrowed and nothing is owed. You're welcome to <a asp-controller="Accounts" asp-action="Apply" asp-route-type="Loan">apply again</a> any time.</p>
            }
            else
            {
                <div class="denied-icon" aria-hidden="true"><i class="bi bi-x-lg"></i></div>
                @if (isCard) { <div class="mb-2"><span class="demo-note">Demo decision, no credit check</span></div> }
                <h1 class="h3 mt-2 mb-2">We couldn't approve this application</h1>
                <p class="text-muted-alto mb-3">Your @product application was reviewed and not approved.</p>
                @if (!string.IsNullOrWhiteSpace(Model.DenialReason))
                {
                    <div class="notice notice-info text-start mx-auto mb-4" style="max-width: 560px">
                        <i class="bi bi-chat-left-text"></i>
                        <div><strong>Reason:</strong> @Model.DenialReason</div>
                    </div>
                }
            }

            <dl class="detail-list text-start mx-auto mb-4" style="max-width: 420px">
                <div><dt>Application #</dt><dd class="font-monospace">ALTO-@Model.Id.ToString("D6")</dd></div>
                <div><dt>Product</dt><dd>@product</dd></div>
                <div><dt>Submitted</dt><dd>@BankTime.ToLocal(Model.SubmittedAt).ToString("MMM d, yyyy h:mm tt")</dd></div>
                <div><dt>Status</dt><dd>@(pending ? "In review" : declined ? "Offer declined" : Model.Status.ToString())</dd></div>
                @if (isLoan)
                {
                    <div><dt>Loan</dt><dd><money amount="@(Model.LoanAmount ?? 0)" /> for @Model.LoanTermMonths months</dd></div>
                    @if (Model.LoanKind == LoanKind.Auto) { <div><dt>Vehicle</dt><dd>@Model.VehicleYear @Model.VehicleMake @Model.VehicleModel</dd></div> }
                }
                @if (isCard && Model.Status == ApplicationStatus.Pending && Model.CreditLimit is decimal proposed)
                {
                    <div><dt>Proposed limit</dt><dd><money amount="@proposed" /></dd></div>
                }
            </dl>

            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a class="btn btn-alto" asp-controller="Dashboard" asp-action="Index">Go to Dashboard</a>
                <a class="btn btn-alto-ghost" asp-controller="Profile" asp-action="Index" asp-fragment="applications">View my applications</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/decision.js" asp-append-version="true"></script>
}
