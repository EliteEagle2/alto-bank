@model DisputeListViewModel
@* /admin/disputes — disputes by status, oldest first. Opens on Submitted (waiting for someone to pick them up). *@
@{
    var q = Model.Query;
    var total = Model.Counts.Values.Sum();
    string Who(ApplicationUser? u) => u == null ? "—" : $"{u.FirstName} {u.LastName}";
    string Tab(DisputeStatus? s, string? customer = null) => Url.Action("Index", new { status = s?.ToString() ?? "all", customer })!;
}

<ul class="nav admin-tabs mb-3">
    @foreach (var s in new DisputeStatus?[] { DisputeStatus.Submitted, DisputeStatus.UnderReview, DisputeStatus.Approved, DisputeStatus.Denied, null })
    {
        var label = s is DisputeStatus st ? (st == DisputeStatus.UnderReview ? "Under review" : st.ToString()) : "All";
        var count = s is DisputeStatus st2 ? Model.Counts.GetValueOrDefault(st2) : total;
        <li class="nav-item"><a class="nav-link @(q.Status == s ? "active" : "")" href="@Tab(s, q.Customer)" aria-current="@(q.Status == s ? "page" : null)">@label (@count)</a></li>
    }
</ul>

<form method="get" class="filter-bar" role="search">
    <input type="hidden" name="status" value="@(q.Status?.ToString() ?? "all")" />
    <div><label for="customer">Customer</label><input id="customer" name="customer" class="form-control" value="@q.Customer" placeholder="Name or email" /></div>
    <div class="filter-actions"><button type="submit" class="btn btn-admin btn-sm">Filter</button>
        @if (!string.IsNullOrWhiteSpace(q.Customer)) { <a class="btn btn-admin-ghost btn-sm" href="@Tab(q.Status)">Clear</a> }
    </div>
</form>

<div class="admin-card p-0">
    <div class="table-responsive">
        <table class="table admin-table table-hover mb-0">
            <thead><tr><th>Dispute</th><th>Filed</th><th>Customer</th><th>Charge</th><th>Reason</th><th class="text-end">Refund if approved</th><th>Status</th></tr></thead>
            <tbody>
                @if (!Model.Disputes.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted-alto py-4">No disputes here.</td></tr>
                }
                @foreach (var d in Model.Disputes.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@d.Id" class="font-monospace">@d.Reference</a>
                            @if (d.ProvisionalCreditTransactionId != null) { <div class="small text-muted-alto">provisional credit</div> }
                        </td>
                        <td class="text-nowrap">@BankTime.ToLocal(d.SubmittedAt).ToString("MMM d, h:mm tt")</td>
                        <td>@Who(d.User)<div class="small text-muted-alto">@d.User?.Email</div></td>
                        <td>@d.Transaction?.Description<div class="small text-muted-alto">@d.Transaction?.TypeLabel, <money amount="@(d.Transaction?.Amount ?? 0)" /></div></td>
                        <td>@Dispute.LabelFor(d.Reason)</td>
                        <td class="text-end"><money amount="@d.RefundAmount" /></td>
                        <td><partial name="_StatusPill" model="d.Status.ToString()" />
                            @if (d.ClawbackOverdrew) { <div class="small text-danger-alto mt-1"><i class="bi bi-exclamation-octagon me-1"></i>clawback overdrew</div> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Disputes.Pager" />
</div>
