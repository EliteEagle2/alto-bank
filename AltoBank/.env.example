# Copy this file to ".env" (same folder) and fill it in. ".env" is git-ignored: never commit real passwords.
# Keys use ASP.NET Core's "__" form: Bank__OwnerEmail = configuration key Bank:OwnerEmail.
# A real environment variable with the same name always wins over this file.

# The OWNER (founder): every admin permission plus adding/removing admins on /admin/staff.
# Not set = the seeded admin (admin@altobank.com) is the owner.
# Bank__OwnerEmail=owner@example.com

# Only used to CREATE the owner's login the first time, if no user has that email yet.
# Min. 8 characters with an upper-case letter, a lower-case letter and a digit.
# Bank__OwnerPassword=ChangeMe123
# Bank__OwnerFirstName=Pat
# Bank__OwnerLastName=Founder
