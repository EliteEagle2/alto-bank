@model FaqItem
@* One collapsible question in the Help Center (Bootstrap accordion item). *@
@{
    var id = "faq-" + Guid.NewGuid().ToString("N")[..8]; // unique id so each item collapses on its own
}
<div class="accordion-item faq-item">
    <h3 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@id" aria-expanded="false" aria-controls="@id">
            @Model.Question
        </button>
    </h3>
    <div id="@id" class="accordion-collapse collapse">
        <div class="accordion-body text-muted-alto">@Model.Answer</div>
    </div>
</div>
