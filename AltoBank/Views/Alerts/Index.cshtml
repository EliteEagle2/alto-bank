@model List<Alert>
@* ALERTS CENTER: everything that happened to your money (payments, requests, bills, budgets, deposits, disputes,
   account status). "View" marks the alert read and opens the page it's about. *@
@{
    bool unreadOnly = ViewBag.UnreadOnly;
    int unread = ViewBag.UnreadCount;
    var today = BankTime.Today;
    string When(DateTime utc)
    {
        var local = BankTime.ToLocal(utc);
        var day = DateOnly.FromDateTime(local);
        return day == today ? $"Today, {local:h:mm tt}" : day == today.AddDays(-1) ? $"Yesterday, {local:h:mm tt}" : local.ToString("MMM d, yyyy h:mm tt");
    }
}

<div class="container py-4 alerts-page">
    <div class="feature-head">
        <div>
            <h2 class="mb-1"><i class="bi bi-bell text-gradient me-2"></i>Alerts</h2>
            <p class="text-muted-alto mb-0">@(unread == 0 ? "You're all caught up." : $"{unread} unread")</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <div class="af-presets" role="group" aria-label="Show">
                <a class="af-chip @(unreadOnly ? "" : "active")" asp-action="Index">All</a>
                <a class="af-chip @(unreadOnly ? "active" : "")" asp-action="Index" asp-route-show="unread">Unread</a>
            </div>
            @if (unread > 0)
            {
                <form asp-action="ReadAll" method="post">
                    <button type="submit" class="btn btn-alto-outline btn-sm"><i class="bi bi-check2-all me-1"></i>Mark all read</button>
                </form>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        var empty = new EmptyStateViewModel("bi-bell-slash", unreadOnly ? "No unread alerts." : "No alerts yet. We'll let you know when money moves.");
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <ul class="alert-list glass" aria-label="Alerts">
            @foreach (var a in Model)
            {
                <li class="alert-item @(a.IsRead ? "" : "is-unread")" data-alert-id="@a.Id">
                    <span class="alert-icon" aria-hidden="true"><i class="bi @a.Icon"></i></span>
                    <div class="alert-body">
                        <div class="alert-title">
                            @if (!a.IsRead) { <span class="unread-dot" aria-label="Unread"></span> }
                            @a.Title
                        </div>
                        <div class="alert-text">@a.Message</div>
                        <div class="alert-time">@When(a.CreatedAt)</div>
                    </div>
                    <div class="alert-actions">
                        @if (a.Link != null)
                        {
                            <form asp-action="Read" asp-route-id="@a.Id" asp-route-open="true" method="post">
                                <button type="submit" class="btn btn-alto-outline btn-sm">View</button>
                            </form>
                        }
                        @if (!a.IsRead)
                        {
                            <form asp-action="Read" asp-route-id="@a.Id" method="post">
                                <button type="submit" class="btn btn-alto-ghost btn-sm" aria-label="Mark “@a.Title” as read"><i class="bi bi-check2"></i></button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>
