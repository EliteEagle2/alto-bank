@model List<Account>
@{
    ViewData["Title"] = "Accounts";
}

<div class="container">
    <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h1 class="mb-1">Accounts</h1>
            <p class="text-muted-alto mb-0">Your checking, savings, credit card and loans.</p>
        </div>
        <a class="btn btn-alto" asp-action="Open"><i class="bi bi-plus-lg me-1"></i>Open new account</a>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="glass">
                    <partial name="_EmptyState" model='new EmptyStateViewModel("bi-wallet2", "No accounts yet. Open your first one above.")' />
                </div>
            </div>
        }
        @foreach (var account in Model)
        {
            <div class="col-md-6 col-xl-4"><partial name="_AccountCard" model="account" /></div>
        }
    </div>
</div>
