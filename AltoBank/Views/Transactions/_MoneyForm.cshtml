@model MoneyMovementViewModel
@* Shared form for Deposit and Withdraw. The parent view passes the action name in ViewData["Action"]. *@
@{
    var action = ViewData["Action"]?.ToString() ?? "Deposit";
}
@if (!Model.AccountOptions.Any())
{
    <partial name="_EmptyState" model='new EmptyStateViewModel("bi-wallet2", "You need an account first.", "Open an account", "Accounts", "Apply")' />
}
else
{
    <form asp-action="@action" method="post">
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>

        <div class="mb-3">
            <label asp-for="AccountId" class="form-label"></label>
            <select asp-for="AccountId" asp-items="Model.AccountOptions" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" value="@(Model.Amount > 0 ? Model.Amount.ToString("0.00") : "")" placeholder="0.00" />
            </div>
            <span asp-validation-for="Amount" class="field-validation-error"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Description" class="form-label">Description (optional)</label>
            <input asp-for="Description" class="form-control" placeholder="@(action == "Deposit" ? "e.g. Paycheck" : "e.g. ATM withdrawal")" />
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-alto">@action</button>
            <a class="btn btn-alto-ghost" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </div>
    </form>
}
