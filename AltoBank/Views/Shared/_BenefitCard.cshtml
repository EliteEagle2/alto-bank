@model BenefitViewModel
@* Glass card with an icon, a heading and a sentence. Used across the product and company pages. *@
<div class="glass glass-hover benefit-card">
    <div class="feature-icon"><i class="bi @Model.Icon"></i></div>
    <h5>@Model.Title</h5>
    <p class="text-muted-alto mb-0">@Model.Text</p>
</div>
