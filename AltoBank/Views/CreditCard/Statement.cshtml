@model CardStatementView
@* Printable Alto Peak statement (simulated): summary box, payment info, transactions in the period, and how interest
   works. Standalone light page like Accounts/Statement; use the browser's Print / Save as PDF. *@
@{
    Layout = null;
    var a = Model.Card;
    var o = Model.Owner;
    var s = Model.Statement;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Statement @s.PeriodEnd.ToString("MMMM d, yyyy") · Alto Peak ••@a.Last4</title>
    <link rel="icon" type="image/svg+xml" href="~/img/mark.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&display=swap" rel="stylesheet" />
    <style>
        :root { --ink: #101826; --muted: #5b6478; --line: #dfe3ea; --accent: #8FB8E8; --green: #0f9d6b; --red: #c62a47; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #eef1f6; color: var(--ink); font: 14px/1.5 "Public Sans", system-ui, sans-serif; }
        .sheet { max-width: 820px; margin: 24px auto; background: #fff; padding: 40px 44px; border-radius: 12px; box-shadow: 0 10px 30px rgba(11,15,26,.12); }
        .toolbar { max-width: 820px; margin: 16px auto 0; display: flex; gap: 8px; justify-content: flex-end; padding: 0 12px; }
        .toolbar a, .toolbar button { font: 600 13px "Public Sans", sans-serif; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--line); background: #fff; color: var(--ink); text-decoration: none; cursor: pointer; }
        .toolbar button { background: var(--accent); color: #fff; border-color: var(--accent); }
        header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid var(--accent); padding-bottom: 16px; margin-bottom: 22px; gap: 16px; }
        .brand { font: 700 22px "Bricolage Grotesque", sans-serif; letter-spacing: .2em; }
        .brand small { display: block; font: 400 12px "Public Sans", sans-serif; letter-spacing: 0; color: var(--muted); }
        h1 { font: 700 20px "Bricolage Grotesque", sans-serif; margin: 0; text-align: right; }
        h2 { font: 700 15px "Bricolage Grotesque", sans-serif; margin: 26px 0 8px; }
        .period { color: var(--muted); text-align: right; }
        .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 22px; }
        .label { font-size: 11px; letter-spacing: .04em; color: var(--muted); }
        .box { border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
        .box.due { border: 2px solid var(--accent); }
        .row { display: flex; justify-content: space-between; padding: 3px 0; gap: 12px; }
        .row.total { border-top: 1px solid var(--line); margin-top: 6px; padding-top: 8px; font-weight: 600; }
        .big { font: 700 22px "Bricolage Grotesque", sans-serif; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; font-size: 11px; letter-spacing: .04em; color: var(--muted); border-bottom: 2px solid var(--line); padding: 8px 6px; }
        td { padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
        .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
        .in { color: var(--green); }
        .muted { color: var(--muted); font-size: 12px; }
        .warn { background: #fff6e5; border: 1px solid #f1d39a; border-radius: 8px; padding: 10px 12px; font-size: 12.5px; margin-top: 12px; }
        footer { margin-top: 28px; color: var(--muted); font-size: 11px; border-top: 1px solid var(--line); padding-top: 12px; }
        @@media (max-width: 640px) { .sheet { padding: 22px 18px; margin: 12px; } .cols { grid-template-columns: 1fr; } header { flex-direction: column; } h1, .period { text-align: left; } }
        @@media print { body { background: #fff; } .toolbar { display: none; } .sheet { box-shadow: none; margin: 0; max-width: none; padding: 0; } }
    </style>
</head>
<body>
    <div class="toolbar">
        <a asp-controller="Accounts" asp-action="Details" asp-route-id="@a.Id" asp-fragment="statements">← Back to card</a>
        <button type="button" onclick="window.print()">Print / Save as PDF</button>
    </div>
    <main class="sheet">
        <header>
            <div class="brand">ALTO BANK<small>@BankService.BankAddress</small></div>
            <div>
                <h1>Alto Peak Card Statement</h1>
                <div class="period">@s.PeriodStart.ToString("MMMM d, yyyy") – @s.PeriodEnd.ToString("MMMM d, yyyy")</div>
            </div>
        </header>

        <div class="cols">
            <div>
                <div class="label">Cardmember</div>
                <div><strong>@o.FirstName @o.LastName</strong></div>
                @if (o.Street != null) { <div>@o.Street@(o.Apt == null ? "" : ", " + o.Apt)</div><div>@o.City, @o.State @o.Zip</div> }
                <div class="muted" style="margin-top:6px">Card ending in @a.Last4 · Credit limit @((a.CreditLimit ?? 0).ToString("C"))</div>
            </div>
            <div class="box due">
                <div class="label">Payment information</div>
                <div class="row"><span>New balance</span><span class="big">@s.StatementBalance.ToString("C")</span></div>
                <div class="row"><span>Minimum payment due</span><strong>@s.MinimumPayment.ToString("C")</strong></div>
                <div class="row"><span>Payment due date</span><strong>@s.DueDate.ToString("MMMM d, yyyy")</strong></div>
            </div>
        </div>

        <div class="box">
            <div class="label">Account summary</div>
            <div class="row"><span>Previous balance</span><span class="num">@s.PreviousBalance.ToString("C")</span></div>
            <div class="row"><span>Payments and credits</span><span class="num in">−@s.PaymentsAndCredits.ToString("C")</span></div>
            <div class="row"><span>Purchases</span><span class="num">+@s.Purchases.ToString("C")</span></div>
            <div class="row"><span>Fees charged</span><span class="num">+@s.FeesCharged.ToString("C")</span></div>
            <div class="row"><span>Interest charged</span><span class="num">+@s.InterestCharged.ToString("C")</span></div>
            <div class="row total"><span>New balance</span><span class="num">@s.StatementBalance.ToString("C")</span></div>
            <div class="muted" style="margin-top:6px">Cash back available: @Model.RewardsBalance.ToString("C") · Purchase APR @s.AprPercent.ToString("0.00")%</div>
        </div>

        @if (s.MinimumPayment > 0)
        {
            <div class="warn">
                <strong>Late payment warning:</strong> if we don't receive your minimum payment by @s.DueDate.ToString("MMMM d"), you may be charged a late fee.
                <strong>Paying only the minimum:</strong> you'll pay interest on the balance you carry. Pay the full @s.StatementBalance.ToString("C") by the due date and you won't be charged interest.
            </div>
        }

        <h2>Transactions</h2>
        <table>
            <thead><tr><th>Date</th><th>Description</th><th class="num">Amount</th></tr></thead>
            <tbody>
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td>@t.LocalDate.ToString("MMM d")</td>
                        <td>@t.Description@if (t.Status == TransactionStatus.Reversed) { <span class="muted"> (reversed)</span> }<div class="muted">@t.TypeLabel</div></td>
                        <td class="num @(t.IsCredit ? "in" : "")">@(t.IsCredit ? "−" : "")@t.Amount.ToString("C")</td>
                    </tr>
                }
                @if (!Model.Transactions.Any()) { <tr><td colspan="3" class="muted">No activity this period.</td></tr> }
            </tbody>
        </table>

        <h2>Interest charge calculation</h2>
        <p class="muted">Interest is figured with the daily balance method: each day's balance × APR ÷ 365, added up for the period.
            There's no interest when the previous statement was paid in full by its due date (the grace period).
            @(s.InterestCharged > 0 ? $"This period: {s.InterestCharged:C}." : "No interest was charged this period.")</p>

        <footer>
            Generated @BankTime.ToLocal(DateTime.UtcNow).ToString("MMMM d, yyyy h:mm tt"). Simulated statement for an academic demo. Alto Bank is not a real bank, the Alto Peak card is not a real credit product, and this is not an official document.
        </footer>
    </main>
</body>
</html>
