@model string
@* Colored status badge (Active, Frozen, Closed, Pending, Approved, Denied, Posted, Reversed, Locked, Cancelled). *@
@{
    var icon = Model switch
    {
        "Active" or "Approved" or "Posted" or "Completed" or "Paid" or "Succeeded" or "PaidOff" => "bi-check-circle",
        "Offered" => "bi-envelope-check",
        "Overdue" => "bi-exclamation-triangle",
        "Frozen" => "bi-snow",
        "Pending" or "Submitted" or "UnderReview" or "Scheduled" => "bi-hourglass-split",
        "Expired" or "Skipped" or "Removed" => "bi-clock-history",
        "Failed" or "Rejected" or "Declined" or "OfferDeclined" => "bi-exclamation-octagon",
        "Locked" => "bi-lock",
        "Closed" or "Cancelled" => "bi-slash-circle",
        "Denied" => "bi-x-circle",
        "Reversed" => "bi-arrow-counterclockwise",
        _ => "bi-dot"
    };
    var css = Model == "Cancelled" ? "closed" : Model.ToLowerInvariant();
    var label = Model switch { "UnderReview" => "Under review", "OfferDeclined" => "Offer declined", "PaidOff" => "Paid off", "Offered" => "Offer sent", _ => Model };
}
<span class="status-pill status-@css"><i class="bi @icon"></i>@label</span>
