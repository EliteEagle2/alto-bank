@model BudgetWidgetViewModel
@* Dashboard: budgets at 75% or more of this month's limit (fullest first). *@
<section class="glass p-4 budget-widget" aria-labelledby="budgetWidgetTitle">
    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h4 class="mb-0" id="budgetWidgetTitle">Budgets to watch</h4>
        <a class="small" asp-controller="Budgets" asp-action="Index">@(Model.HasBudgets ? "All budgets" : "Set one up")</a>
    </div>
    @if (!Model.HasBudgets)
    {
        <p class="text-muted-alto mb-0">Set a monthly limit for groceries, dining or anything else, and we'll show it here when you're getting close.</p>
    }
    else if (!Model.NearLimit.Any())
    {
        <p class="mb-0"><i class="bi bi-check-circle-fill text-success-alto me-2" aria-hidden="true"></i>You're on track: every budget is under 75% this month.</p>
    }
    else
    {
        <div class="budget-list">
            @foreach (var b in Model.NearLimit.Take(3)) { <partial name="_BudgetBar" model="b" /> }
        </div>
        @if (Model.NearLimit.Count > 3)
        {
            <a class="small d-inline-block mt-2" asp-controller="Budgets" asp-action="Index">@(Model.NearLimit.Count - 3) more near the limit</a>
        }
    }
</section>
