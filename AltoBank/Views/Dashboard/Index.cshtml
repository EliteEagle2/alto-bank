@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    @* Greeting + total balance, over the Ridgeline contour lines *@
    <section class="balance-hero" aria-label="Total balance">
        <p class="balance-hero-greeting">@Model.Greeting, @Model.FirstName</p>
        <h1 class="visually-hidden">Dashboard</h1>
        <div class="total-balance"><money amount="@Model.TotalBalance" /></div>
        <p class="balance-hero-meta">Total across @Model.Accounts.Count(a => a.Status != AccountStatus.Closed) account@(Model.Accounts.Count(a => a.Status != AccountStatus.Closed) == 1 ? "" : "s")</p>
    </section>

    <partial name="_QuickActions" />

    @* Account summary cards *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Your accounts</h4>
        <a asp-controller="Accounts" asp-action="Index" class="small">View all</a>
    </div>
    <div class="row g-4 mb-5">
        @if (!Model.Accounts.Any())
        {
            <div class="col-12">
                <div class="glass">
                    <partial name="_EmptyState" model='new EmptyStateViewModel("bi-wallet2", "You have no accounts yet.", "Open an account", "Accounts", "Apply")' />
                </div>
            </div>
        }
        @foreach (var account in Model.Accounts)
        {
            <div class="col-md-6 col-xl-4"><partial name="_AccountCard" model="account" /></div>
        }
    </div>

    <div class="row g-4">
        @* 30-day money in vs. out (Chart.js). The numbers are serialized to JSON in data-flows. *@
        <div class="col-xl-5 order-xl-2">
            <div class="glass p-4 h-100">
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <h4 class="mb-0">Last 30 days</h4>
                    <span class="small text-muted-alto">excludes transfers between your accounts</span>
                </div>
                <div class="d-flex gap-4 my-3">
                    <div><div class="small text-muted-alto">Money in</div><money amount="@Model.Flows.Sum(f => f.In)" class="fs-5 fw-semibold text-success-alto" /></div>
                    <div><div class="small text-muted-alto">Money out</div><money amount="@Model.Flows.Sum(f => f.Out)" class="fs-5 fw-semibold text-danger-alto" /></div>
                </div>
                <div class="flow-chart">
                    <canvas id="flowChart" role="img" aria-label="Money in and out per day for the last 30 days"
                            data-flows="@System.Text.Json.JsonSerializer.Serialize(Model.Flows, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))"></canvas>
                </div>
            </div>
        </div>

        @* Recent transactions across all accounts — shared table partial, with the Account column *@
        <div class="col-xl-7 order-xl-1">
            <h4 class="mb-3">Recent transactions</h4>
            <partial name="_TransactionTable" model='new TransactionTableViewModel { Transactions = Model.RecentTransactions, ShowAccount = true }' />
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
