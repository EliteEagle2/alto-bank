@model ScheduleEditInput
@* Edit one scheduled payment/transfer. To change how often it repeats, cancel it and schedule a new one. *@
@{ var s = Model.Item!; }
<div class="container py-5">
    <div class="glass form-card">
        <h2 class="h4 mb-1"><i class="bi bi-pencil text-gradient me-2"></i>Edit scheduled @(s.Kind == ScheduleKind.BillPay ? "payment" : "transfer")</h2>
        <p class="text-muted-alto mb-4">@(s.Kind == ScheduleKind.Transfer ? "To " : "")@s.Target · @s.ScheduleText</p>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>
            <div class="mb-3">
                <label asp-for="FromAccountId" class="form-label"></label>
                <select asp-for="FromAccountId" asp-items="Model.Accounts" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <div class="input-group"><span class="input-group-text">$</span><input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" value="@Model.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" /></div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-sm-6"><label asp-for="NextRunDate" class="form-label"></label><input asp-for="NextRunDate" type="date" class="form-control" min="@BankTime.Today.ToString("yyyy-MM-dd")" max="@BankTime.Today.AddYears(1).ToString("yyyy-MM-dd")" />
                    @if (s.IsRecurring) { <div class="form-text">Repeats @s.ScheduleText.ToLowerInvariant(), so pick a date on that day.</div> }</div>
                @if (s.IsRecurring)
                {
                    <div class="col-sm-6"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" min="@BankTime.Today.ToString("yyyy-MM-dd")" /></div>
                }
            </div>
            <div class="mb-4"><label asp-for="Memo" class="form-label"></label><input asp-for="Memo" class="form-control" maxlength="80" /></div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-alto">Save changes</button>
                <a class="btn btn-alto-ghost" asp-action="Index">Back</a>
            </div>
        </form>
    </div>
</div>
