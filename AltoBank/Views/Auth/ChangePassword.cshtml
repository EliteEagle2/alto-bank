@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    var forced = ViewData["Forced"] is true;
}

<div class="auth-wrap">
    <div class="glass auth-card">
        <h2 class="mb-1">Choose a new password</h2>
        @if (forced)
        {
            <div class="demo-box mb-4 mt-3">
                <i class="bi bi-shield-lock me-1"></i>
                Alto Bank gave you a temporary password. Please replace it with your own before continuing.
            </div>
        }
        else
        {
            <p class="text-muted-alto mb-4">Enter your current password, then your new one.</p>
        }

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <div class="form-text text-muted-alto">At least 8 characters with an uppercase letter, a lowercase letter, a number, and a symbol.</div>
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <button type="submit" class="btn btn-alto w-100 py-2">Save new password</button>
        </form>
        <form asp-action="Logout" method="post" class="text-center mt-3">
            <button type="submit" class="btn btn-link btn-sm text-muted-alto">Log out instead</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
