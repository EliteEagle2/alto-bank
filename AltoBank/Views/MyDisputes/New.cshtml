@model DisputePageViewModel
@* DISPUTE A CHARGE — /disputes/new?transactionId=5. Steps: what went wrong (with the extra question some reasons need),
   what happened, an optional receipt, then a review. Without JavaScript every part is visible and the form posts
   normally; wwwroot/js/dispute.js shows only the parts that apply and adds the review step. The server checks it all. *@
@{
    var t = Model.Transaction;
    var reasons = new[]
    {
        (DisputeReason.NotAuthorized, "bi-person-x", "Someone else made this charge, or I don't recognize it."),
        (DisputeReason.WrongAmount, "bi-calculator", "I was charged more than I agreed to pay."),
        (DisputeReason.NotReceived, "bi-box-seam", "I paid but never got what I paid for."),
        (DisputeReason.Duplicate, "bi-files", "I was charged twice for the same thing."),
        (DisputeReason.Other, "bi-three-dots", "Something else is wrong with this charge.")
    };
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="container py-4 dispute-page" id="disputeForm" data-amount="@t.Amount.ToString(inv)">
    <div class="feature-head">
        <div>
            <a asp-controller="Accounts" asp-action="Details" asp-route-id="@t.AccountId" asp-fragment="activity" class="small text-decoration-none"><i class="bi bi-chevron-left"></i> Back to activity</a>
            <h2 class="mt-1 mb-1"><i class="bi bi-shield-exclamation text-gradient me-2"></i>Dispute a charge</h2>
            <p class="text-muted-alto mb-0">Tell us what's wrong. We'll review it and send you an alert with our decision.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <section class="glass pay-card" aria-labelledby="disputeFormTitle">
                <h3 class="visually-hidden" id="disputeFormTitle">Dispute form</h3>
                <form asp-action="Submit" method="post" enctype="multipart/form-data" novalidate data-dispute-form>
                    <input type="hidden" asp-for="Form.TransactionId" />
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-alto-error small mb-3" role="alert"></div>
                    }
                    @if (ViewData["AttachmentCleared"] is true)
                    {
                        <p class="small text-muted-alto mb-3"><i class="bi bi-info-circle me-1"></i>For your security, the attachment isn't kept when something needs fixing. Please add it again.</p>
                    }

                    @* ---------- 1. What went wrong ---------- *@
                    <fieldset class="check-step" data-step>
                        <legend><span class="check-step-num" aria-hidden="true">1</span>What went wrong?</legend>
                        <div class="reason-grid" role="radiogroup">
                            @foreach (var (r, icon, hint) in reasons)
                            {
                                <label class="reason-card">
                                    <input type="radio" name="Form.Reason" value="@r" checked="@(Model.Form.Reason == r)" data-reason required />
                                    <span class="reason-body">
                                        <i class="bi @icon" aria-hidden="true"></i>
                                        <span><strong>@Dispute.LabelFor(r)</strong><span class="d-block small text-muted-alto">@hint</span></span>
                                    </span>
                                </label>
                            }
                        </div>

                        @* Only for "Wrong amount" *@
                        <div class="reason-extra" data-for="WrongAmount">
                            <label asp-for="Form.ExpectedAmount" class="form-label"></label>
                            <div class="input-group" style="max-width: 16rem">
                                <span class="input-group-text">$</span>
                                <input asp-for="Form.ExpectedAmount" class="form-control" type="number" step="0.01" min="0.01" max="@((t.Amount - 0.01m).ToString(inv))" placeholder="0.00" inputmode="decimal" data-expected />
                            </div>
                            <div class="form-text" data-expected-msg>You were charged <money amount="@t.Amount" />. If we agree, we refund the difference.</div>
                        </div>

                        @* Only for "Duplicate charge" *@
                        <div class="reason-extra" data-for="Duplicate">
                            <span class="form-label d-block">Which charge is the original?</span>
                            @if (!Model.SimilarCharges.Any())
                            {
                                <p class="small text-danger-alto mb-0">We couldn't find another "@t.Description" charge within 30 days of this one. Choose "Something else" and tell us about it.</p>
                            }
                            else
                            {
                                <div class="dup-list">
                                    @foreach (var s in Model.SimilarCharges)
                                    {
                                        <label class="dup-option">
                                            <input type="radio" name="Form.DuplicateOfTransactionId" value="@s.Id" checked="@(Model.Form.DuplicateOfTransactionId == s.Id)" data-duplicate />
                                            <span>@s.Description<span class="d-block small text-muted-alto">@s.LocalDate.ToString("MMM d, yyyy h:mm tt")</span></span>
                                            <money amount="@(-s.Amount)" colorize="true" show-sign="true" />
                                        </label>
                                    }
                                </div>
                            }
                        </div>

                        @* Only for "I didn't authorize it" *@
                        <div class="reason-extra" data-for="NotAuthorized">
                            @if (Model.ActiveCard is Card card)
                            {
                                <div class="form-check freeze-offer">
                                    <input asp-for="Form.FreezeCard" class="form-check-input" />
                                    <label asp-for="Form.FreezeCard" class="form-check-label">
                                        <strong>Also freeze my debit card ••@card.Last4</strong>
                                        <span class="d-block small text-muted-alto">Stops new card purchases right away. You can unfreeze it on the account's Card tab.</span>
                                    </label>
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted-alto mb-0"><i class="bi bi-info-circle me-1"></i>If you think someone has your card details, freeze or replace the card on the account's Card tab.</p>
                            }
                        </div>
                    </fieldset>

                    @* ---------- 2. What happened ---------- *@
                    <fieldset class="check-step" data-step>
                        <legend><span class="check-step-num" aria-hidden="true">2</span>What happened</legend>
                        <label asp-for="Form.Description" class="visually-hidden"></label>
                        <textarea asp-for="Form.Description" class="form-control" rows="5" maxlength="1000" data-description
                                  placeholder="For example: I returned the jacket on Oct 3 and the store said I'd get a refund in 5 days. It never came."></textarea>
                        <div class="form-text d-flex justify-content-between"><span>At least 20 characters.</span><span data-count aria-live="polite"></span></div>
                    </fieldset>

                    @* ---------- 3. Receipt (optional) ---------- *@
                    <fieldset class="check-step" data-step>
                        <legend><span class="check-step-num" aria-hidden="true">3</span>A receipt or screenshot <span class="text-muted-alto fw-normal">(optional)</span></legend>
                        <input asp-for="Form.Attachment" type="file" class="form-control" accept="image/jpeg,image/png" data-attachment />
                        <div class="form-text">A JPG or PNG photo or screenshot, up to 5 MB. For example the receipt, an order confirmation or a chat with the merchant.</div>
                        <p class="drop-error small mb-0" data-attachment-error aria-live="polite"></p>
                    </fieldset>

                    @* ---------- 4. Review ---------- *@
                    <div class="check-review-gate" data-review-gate hidden>
                        <button type="button" class="btn btn-alto" data-review-open disabled>Review dispute</button>
                        <span class="small text-muted-alto ms-2" data-gate-msg>Fill in the steps above to continue.</span>
                    </div>
                    <fieldset class="check-step check-review" data-review>
                        <legend tabindex="-1" data-review-title><span class="check-step-num" aria-hidden="true">4</span>Review and submit</legend>
                        <dl class="review-list" data-review-list hidden>
                            <div><dt>Charge</dt><dd>@t.Description, <money amount="@t.Amount" /></dd></div>
                            <div><dt>Reason</dt><dd data-review-reason></dd></div>
                            <div><dt>If we agree, we refund</dt><dd data-review-refund></dd></div>
                            <div><dt>Attachment</dt><dd data-review-attachment></dd></div>
                        </dl>
                        <p class="small text-muted-alto">
                            @if (Model.ProvisionalCredit)
                            {
                                <span><strong>We'll credit the amount right away</strong> while we review. If the dispute is denied, we'll take it back, even if that brings the balance below $0.</span>
                            }
                            else
                            {
                                <span>Nothing changes in your account until we decide. You'll get an alert either way.</span>
                            }
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-alto" data-submit><i class="bi bi-send me-1"></i>Submit dispute</button>
                            <button type="button" class="btn btn-alto-ghost" data-review-back-btn hidden>Edit</button>
                        </div>
                    </fieldset>
                </form>
            </section>
        </div>

        <div class="col-lg-5 d-flex flex-column gap-4">
            <section class="glass p-4" aria-labelledby="chargeTitle">
                <h3 class="h6 mb-3" id="chargeTitle">The charge</h3>
                <div class="dispute-charge">
                    <div class="fs-4 fw-semibold"><money amount="@t.Amount" /></div>
                    <div>@t.Description</div>
                    <div class="small text-muted-alto">@t.TypeLabel, @t.LocalDate.ToString("MMM d, yyyy h:mm tt")</div>
                    <div class="small text-muted-alto">@t.Account?.DisplayName ••@t.Account?.Last4</div>
                </div>
            </section>
            <section class="glass p-4" aria-labelledby="howTitle">
                <h3 class="h6 mb-3" id="howTitle">How disputes work</h3>
                <ol class="dispute-how small mb-0">
                    <li>We review what you send us, usually within a few business days.</li>
                    <li>If we agree, we refund the charge (or the difference, for a wrong amount).</li>
                    <li>If we don't, we tell you why. You can see the status any time under Accounts → Disputes.</li>
                </ol>
                @if (t.Type == TransactionType.PaymentSent)
                {
                    <p class="small text-muted-alto mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>For a payment you sent to someone, a refund comes from Alto. We don't take the money back from the person you paid.</p>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dispute.js" asp-append-version="true"></script>
}
