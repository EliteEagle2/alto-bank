@* Row of shortcut buttons at the top of the dashboard. *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a class="glass glass-hover quick-action" asp-controller="Transactions" asp-action="Deposit"><i class="bi bi-arrow-down-circle"></i>Deposit</a>
    </div>
    <div class="col-6 col-md-3">
        <a class="glass glass-hover quick-action" asp-controller="Transactions" asp-action="Withdraw"><i class="bi bi-arrow-up-circle"></i>Withdraw</a>
    </div>
    <div class="col-6 col-md-3">
        <a class="glass glass-hover quick-action" asp-controller="Transactions" asp-action="Transfer"><i class="bi bi-arrow-left-right"></i>Transfer</a>
    </div>
    <div class="col-6 col-md-3">
        <a class="glass glass-hover quick-action" asp-controller="Accounts" asp-action="Apply"><i class="bi bi-plus-lg"></i>Open Account</a>
    </div>
</div>
