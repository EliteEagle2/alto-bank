@model TransactionRowViewModel
@* One row in the Account Details activity list. Click the row to expand the details.
   (account-details.js builds rows for "Load more" with the same markup.)
   The expanded part has the category picker: a normal form (POST /transactions/{id}/category, antiforgery token,
   then back here), which account-details.js sends to the JSON API instead so the page doesn't reload. *@
@{
    var t = Model.Transaction;
    var icon = t.Type switch
    {
        TransactionType.Deposit => "bi-arrow-down-left",
        TransactionType.Withdrawal => "bi-arrow-up-right",
        TransactionType.TransferIn or TransactionType.TransferOut => "bi-arrow-left-right",
        TransactionType.Interest => "bi-percent",
        TransactionType.AdjustmentCredit or TransactionType.AdjustmentDebit => "bi-sliders",
        TransactionType.PaymentSent => "bi-send",
        TransactionType.PaymentReceived => "bi-person-down",
        TransactionType.BillPayment => "bi-receipt",
        TransactionType.CheckDeposit => "bi-camera",
        _ => "bi-arrow-counterclockwise"
    };
    var reversed = t.Status == TransactionStatus.Reversed;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}#activity";   // keeps any filters
}
<div class="tx-row @(reversed ? "is-reversed" : "")" data-tx-id="@t.Id">
    <button type="button" class="tx-main" aria-expanded="false" aria-controls="tx-more-@t.Id">
        <span class="tx-icon @(t.IsCredit ? "in" : "out")" aria-hidden="true"><i class="bi @icon"></i></span>
        <span class="tx-desc">
            <span class="tx-title">@t.Description</span>
            <span class="tx-sub">@t.TypeLabel · @t.LocalDate.ToString("h:mm tt")
                <span class="cat-chip" data-cat-chip>@Categories.Label(t.Category)</span>
                @if (reversed) { <span class="badge-reversed">Reversed</span> }
            </span>
        </span>
        <span class="tx-amounts">
            <money amount="@t.SignedAmount" colorize="true" show-sign="true" class="tx-amount" />
            <span class="tx-bal">Bal <money amount="@t.BalanceAfter" /></span>
        </span>
        <i class="bi bi-chevron-down tx-caret" aria-hidden="true"></i>
    </button>
    <div class="tx-more" id="tx-more-@t.Id" hidden>
        <dl class="tx-dl">
            <div><dt>Transaction ID</dt><dd class="font-monospace">#@t.Id</dd></div>
            <div><dt>Date &amp; time</dt><dd>@t.LocalDate.ToString("MMM d, yyyy h:mm:ss tt")</dd></div>
            <div><dt>Type</dt><dd>@t.TypeLabel</dd></div>
            <div><dt>Counterparty</dt><dd>@(Model.Counterparty ?? "—")</dd></div>
            <div><dt>Memo</dt><dd>@(t.Memo ?? "—")</dd></div>
            <div><dt>Status</dt><dd>@(reversed ? "Reversed" : "Posted")</dd></div>
        </dl>
        <form class="tx-cat-form" method="post" action="@Url.Action("Recategorize", "Insights", new { id = t.Id })" data-tx-cat>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <label class="form-label small mb-0" for="cat-@t.Id">Category</label>
            <select class="form-select form-select-sm" id="cat-@t.Id" name="category">
                @foreach (var c in Categories.All)
                {
                    <option value="@c" selected="@(c == t.Category)">@Categories.Label(c)</option>
                }
                @if (t.CategoryOverridden)
                {
                    <option value="auto">Let Alto pick again</option>
                }
            </select>
            <button type="submit" class="btn btn-alto-outline btn-sm">Save</button>
            <span class="small text-muted-alto" data-cat-note>@(t.CategoryOverridden ? "You chose this category." : "Alto picked this category from the merchant name.")</span>
        </form>
    </div>
</div>
