@model MoneyMovementViewModel
@{
    ViewData["Title"] = "Deposit";
}

<div class="container py-5">
    <div class="glass form-card">
        <h2 class="mb-1"><i class="bi bi-arrow-down-circle text-success-alto me-2"></i>Deposit</h2>
        <p class="text-muted-alto mb-4">Add money to one of your accounts.</p>
        <partial name="_MoneyForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Action"] = "Deposit" }' />
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
