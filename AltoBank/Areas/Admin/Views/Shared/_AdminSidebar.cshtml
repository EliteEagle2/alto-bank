@* ADMIN NAVIGATION (every admin page links here; add new admin pages to the groups below).
   Unlike the customer site's left sidebar, the admin console uses a horizontal, grouped bar under the
   header on large screens. On phones/tablets the same markup becomes a slide-out drawer
   (Bootstrap "offcanvas-lg"), opened by the menu button in the console bar. *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    bool IsActive(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase);
    var groups = AdminNav.Groups;
}
<nav class="console-nav offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-label="Admin navigation">
    <div class="offcanvas-header">
        <span class="admin-brand"><partial name="_Logo" /><span class="admin-brand-tag">Admin</span></span>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form class="console-search d-md-none mb-3" method="get" asp-area="Admin" asp-controller="Customers" asp-action="Index" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input name="search" class="form-control" placeholder="Find a customer" aria-label="Find a customer by name or email" />
        </form>
        <div class="cn-groups">
            @foreach (var g in groups)
            {
                <div class="cn-group">
                    @if (g.Label != null) { <span class="cn-label">@g.Label</span> }
                    @foreach (var l in g.Links)
                    {
                        <a class="admin-link @(IsActive(l.Controller) ? "active" : "")" asp-area="Admin" asp-controller="@l.Controller" asp-action="Index"
                           aria-current="@(IsActive(l.Controller) ? "page" : null)">
                            <i class="bi @l.Icon" aria-hidden="true"></i><span>@l.Text</span>
                        </a>
                    }
                </div>
            }
        </div>
        <div class="cn-drawer-foot d-lg-none">
            <a class="admin-link" href="/swagger" target="_blank" rel="noopener"><i class="bi bi-braces"></i><span>API docs</span></a>
            <a class="admin-link" asp-area="" asp-controller="Home" asp-action="Index" target="_blank"><i class="bi bi-box-arrow-up-right"></i><span>Customer website</span></a>
        </div>
    </div>
</nav>
