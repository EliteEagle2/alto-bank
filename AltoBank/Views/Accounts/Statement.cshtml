@model StatementData
@* Printable monthly statement (simulated). A standalone, light, print-friendly page (no site layout).
   Opened from Account Info → Statements; use the browser's Print / Save as PDF. *@
@{
    Layout = null;
    var a = Model.Account;
    var o = Model.Owner;
    var start = new DateTime(Model.Year, Model.Month, 1);
    var end = start.AddMonths(1).AddDays(-1);
    var isCurrent = Model.Year == DateTime.UtcNow.Year && Model.Month == DateTime.UtcNow.Month;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Statement @start.ToString("MMMM yyyy") · @a.DisplayName ••@a.Last4</title>
    <link rel="icon" type="image/svg+xml" href="~/img/mark.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&display=swap" rel="stylesheet" />
    <style>
        :root { --ink: #101826; --muted: #5b6478; --line: #dfe3ea; --accent: #8FB8E8; --green: #0f9d6b; --red: #c62a47; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #eef1f6; color: var(--ink); font: 14px/1.5 Inter, system-ui, sans-serif; }
        .sheet { max-width: 820px; margin: 24px auto; background: #fff; padding: 40px 44px; border-radius: 12px; box-shadow: 0 10px 30px rgba(11,15,26,.12); }
        .toolbar { max-width: 820px; margin: 16px auto 0; display: flex; gap: 8px; justify-content: flex-end; }
        .toolbar a, .toolbar button { font: 600 13px Inter, sans-serif; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--line); background: #fff; color: var(--ink); text-decoration: none; cursor: pointer; }
        .toolbar button { background: var(--accent); color: #fff; border-color: var(--accent); }
        header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid var(--accent); padding-bottom: 16px; margin-bottom: 22px; }
        .brand { font: 700 22px "Bricolage Grotesque", sans-serif; letter-spacing: .2em; }
        .brand small { display: block; font: 400 12px Inter, sans-serif; letter-spacing: 0; color: var(--muted); }
        h1 { font: 700 20px "Bricolage Grotesque", sans-serif; margin: 0; text-align: right; }
        .period { color: var(--muted); text-align: right; }
        .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 22px; }
        .label { font-size: 11px; text-transform: none; letter-spacing: .08em; color: var(--muted); }
        .summary { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; margin-bottom: 24px; }
        .summary div { padding: 12px 14px; border-right: 1px solid var(--line); }
        .summary div:last-child { border-right: 0; }
        .summary strong { display: block; font: 700 17px "Bricolage Grotesque", sans-serif; margin-top: 2px; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; font-size: 11px; text-transform: none; letter-spacing: .06em; color: var(--muted); border-bottom: 2px solid var(--line); padding: 8px 6px; }
        td { padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
        .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
        .in { color: var(--green); } .out { color: var(--red); }
        .muted { color: var(--muted); font-size: 12px; }
        footer { margin-top: 28px; color: var(--muted); font-size: 11px; border-top: 1px solid var(--line); padding-top: 12px; }
        @@media (max-width: 640px) { .sheet { padding: 22px 18px; } .cols, .summary { grid-template-columns: 1fr 1fr; } }
        @@media print { body { background: #fff; } .toolbar { display: none; } .sheet { box-shadow: none; margin: 0; max-width: none; padding: 0; } }
    </style>
</head>
<body>
    <div class="toolbar">
        <a asp-action="Details" asp-route-id="@a.Id" asp-fragment="info">← Back to account</a>
        <button type="button" onclick="window.print()">Print / Save as PDF</button>
    </div>
    <main class="sheet">
        <header>
            <div class="brand">ALTO BANK<small>@BankService.BankAddress</small></div>
            <div>
                <h1>Account Statement@(isCurrent ? " (month to date)" : "")</h1>
                <div class="period">@start.ToString("MMMM d, yyyy") – @end.ToString("MMMM d, yyyy")</div>
            </div>
        </header>

        <div class="cols">
            <div>
                <div class="label">Account holder</div>
                <div><strong>@o.FirstName @o.LastName</strong></div>
                @if (o.Street != null) { <div>@o.Street@(o.Apt == null ? "" : ", " + o.Apt)</div><div>@o.City, @o.State @o.Zip</div> }
            </div>
            <div>
                <div class="label">Account</div>
                <div><strong>@a.DisplayName</strong> (@a.AccountType)</div>
                <div>Account number ****@a.Last4</div>
                <div>Routing number @BankService.RoutingNumber</div>
            </div>
        </div>

        <div class="summary">
            <div><span class="label">Opening balance</span><strong>@Model.OpeningBalance.ToString("C")</strong></div>
            <div><span class="label">Money in</span><strong class="in">+@Model.TotalIn.ToString("C")</strong></div>
            <div><span class="label">Money out</span><strong class="out">−@Model.TotalOut.ToString("C")</strong></div>
            <div><span class="label">Closing balance</span><strong>@Model.ClosingBalance.ToString("C")</strong></div>
        </div>

        <table>
            <thead><tr><th>Date</th><th>Description</th><th class="num">Amount</th><th class="num">Balance</th></tr></thead>
            <tbody>
                <tr><td>@start.ToString("MMM d")</td><td class="muted">Opening balance</td><td></td><td class="num">@Model.OpeningBalance.ToString("C")</td></tr>
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td>@t.LocalDate.ToString("MMM d")</td>
                        <td>@t.Description@if (t.Status == TransactionStatus.Reversed) { <span class="muted"> (reversed)</span> }<div class="muted">@t.TypeLabel@(t.Memo == null ? "" : " · " + t.Memo)</div></td>
                        <td class="num @(t.IsCredit ? "in" : "out")">@(t.IsCredit ? "+" : "−")@t.Amount.ToString("C")</td>
                        <td class="num">@t.BalanceAfter.ToString("C")</td>
                    </tr>
                }
                @if (!Model.Transactions.Any()) { <tr><td colspan="4" class="muted">No transactions this month.</td></tr> }
            </tbody>
        </table>

        <footer>
            Generated @DateTime.Now.ToString("MMMM d, yyyy h:mm tt"). Simulated statement for an academic demo. Alto Bank is not a real bank and this is not an official document.
        </footer>
    </main>
</body>
</html>
