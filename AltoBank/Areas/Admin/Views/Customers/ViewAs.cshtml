@model ViewAsViewModel
@* READ-ONLY "View as customer". The admin is still logged in as the admin (no impersonation),
   and this page has no forms, so nothing here can change the customer's data.
   pointer-events are also disabled on the preview so links/buttons can't be clicked. *@
@{
    var u = Model.User;
}
<div class="viewas-banner" role="status">
    <span><i class="bi bi-eye me-2"></i>Viewing as @u.FirstName @u.LastName · read only</span>
    <a class="btn btn-admin-ghost btn-sm" asp-action="Details" asp-route-id="@u.Id"><i class="bi bi-x-lg me-1"></i>Exit preview</a>
</div>

<div class="viewas-frame" aria-label="Read-only preview of the customer dashboard">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <p class="text-muted-alto mb-1">Hello,</p>
            <h2 class="mb-0">@u.FirstName</h2>
        </div>
        <div class="text-end">
            <div class="kpi-label">Total balance</div>
            <div class="big-balance text-gradient"><money amount="@Model.TotalBalance" /></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var account in Model.Accounts)
        {
            <div class="col-md-6 col-xl-4">
                @* Same partial the customer dashboard uses. *@
                <partial name="_AccountCard" model="account" />
            </div>
        }
    </div>

    <h3 class="h5 mb-3">Recent transactions</h3>
    <partial name="_TransactionTable" model='new TransactionTableViewModel { Transactions = Model.Recent, ShowAccount = true }' />
</div>
