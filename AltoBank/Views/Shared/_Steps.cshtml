@model List<StepViewModel>
@* Numbered "How it works" steps. The number comes from the loop index. *@
<div class="row g-4">
    @for (var i = 0; i < Model.Count; i++)
    {
        <div class="col-md-4">
            <div class="step">
                <div class="step-num">@(i + 1)</div>
                <h5>@Model[i].Title</h5>
                <p class="text-muted-alto mb-0">@Model[i].Text</p>
            </div>
        </div>
    }
</div>
