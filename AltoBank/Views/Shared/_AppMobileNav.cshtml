@* Bottom tab bar shown only on phones/tablets (like a mobile banking app): the same groups as the sidebar
   (ViewModels/CustomerNav.cs). Alerts and Profile are in the top bar (bell, avatar menu). *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var tabs = new[] { (CustomerNav.Home, "Home"), (CustomerNav.Accounts, "Accounts"), (CustomerNav.MoveMoney, "Move"), (CustomerNav.Pay, "Pay"), (CustomerNav.Insights, "Insights") };
}
<nav class="mobile-tabbar d-lg-none" aria-label="Quick navigation">
    @foreach (var (g, label) in tabs)
    {
        var on = g.IsCurrent(controller, action);
        <a class="@(on ? "active" : "")" asp-controller="@g.Home.Controller" asp-action="@g.Home.Action" aria-current="@(on ? "page" : null)"><i class="bi @g.Icon" aria-hidden="true"></i>@label</a>
    }
</nav>
