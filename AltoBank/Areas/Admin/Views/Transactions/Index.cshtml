@model PagedList<Transaction>
@{
    var q = (TransactionListQuery)ViewBag.Query;
    var exportQuery = Context.Request.Query.Where(kv => kv.Key != "page").ToDictionary(kv => kv.Key, kv => kv.Value.ToString());
}
<form method="get" class="filter-bar" role="search">
    <div><label for="from">From</label><input id="from" name="from" type="date" class="form-control" value="@q.From?.ToString("yyyy-MM-dd")" /></div>
    <div><label for="to">To</label><input id="to" name="to" type="date" class="form-control" value="@q.To?.ToString("yyyy-MM-dd")" /></div>
    <div>
        <label for="type">Type</label>
        <select id="type" name="type" class="form-select">
            <option value="">All</option>
            @foreach (var t in Enum.GetValues<TransactionType>()) { <option value="@t" selected="@(q.Type == t)">@Transaction.LabelFor(t) (@t)</option> }
        </select>
    </div>
    <div><label for="minAmount">Min $</label><input id="minAmount" name="minAmount" type="number" min="0" step="0.01" class="form-control" style="width:105px" value="@q.MinAmount" /></div>
    <div><label for="maxAmount">Max $</label><input id="maxAmount" name="maxAmount" type="number" min="0" step="0.01" class="form-control" style="width:105px" value="@q.MaxAmount" /></div>
    <div><label for="customer">Customer</label><input id="customer" name="customer" class="form-control" value="@q.Customer" placeholder="name or email" /></div>
    <div><label for="accountId">Account ID</label><input id="accountId" name="accountId" type="number" min="1" class="form-control" style="width:100px" value="@q.AccountId" /></div>
    <button type="submit" class="btn btn-admin"><i class="bi bi-funnel"></i> Filter</button>
    <a class="btn btn-admin-ghost" asp-action="Index">Reset</a>
    <a class="btn btn-admin-ghost" asp-action="Export" asp-all-route-data="exportQuery"><i class="bi bi-download"></i> CSV</a>
</form>

<div class="admin-card p-0">
    <div class="table-responsive">
        <table class="table admin-table table-hover mb-0">
            <thead><tr><th>#</th><th>Date</th><th>Customer</th><th>Account</th><th>Description</th><th>Type</th><th>Status</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
                @if (!Model.Items.Any()) { <tr><td colspan="8" class="text-center text-muted-alto py-4">No transactions match these filters.</td></tr> }
                @foreach (var t in Model.Items)
                {
                    <tr class="@(t.Status == TransactionStatus.Reversed ? "is-muted" : "")">
                        <td><a asp-action="Details" asp-route-id="@t.Id">@t.Id</a></td>
                        <td class="text-nowrap">@t.LocalDate.ToString("MMM d, yyyy h:mm tt")</td>
                        <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@t.Account?.UserId">@t.Account?.User?.FirstName @t.Account?.User?.LastName</a></td>
                        <td><a asp-controller="Accounts" asp-action="Details" asp-route-id="@t.AccountId">••@t.Account?.Last4</a></td>
                        <td>@t.Description</td>
                        <td>@t.TypeLabel</td>
                        <td><partial name="_StatusPill" model="t.Status.ToString()" /></td>
                        <td class="text-end"><money amount="@t.SignedAmount" colorize="true" show-sign="true" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>
