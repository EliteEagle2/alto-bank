@* Activity filters: search, type, date presets (30d / 90d / This year / Custom), CSV download.
   account-details.js reloads the list from the JSON API whenever a filter changes. *@
@model AccountDetailsViewModel
<form class="activity-filters" id="activityFilters" role="search" onsubmit="return false">
    <div class="af-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" name="search" class="form-control" placeholder="Search description or memo" aria-label="Search activity" />
    </div>
    <select name="kind" class="form-select" aria-label="Transaction type">
        <option value="">All types</option>
        <option value="in">Money in</option>
        <option value="out">Money out</option>
        <option value="deposit">Deposits</option>
        <option value="withdrawal">Withdrawals</option>
        <option value="transfer">Transfers</option>
        <option value="interest">Interest</option>
        <option value="adjustment">Adjustments</option>
        <option value="reversal">Reversals</option>
    </select>
    <div class="af-presets" role="group" aria-label="Date range">
        <button type="button" class="af-chip" data-preset="30">30 days</button>
        <button type="button" class="af-chip active" data-preset="90">90 days</button>
        <button type="button" class="af-chip" data-preset="year">This year</button>
        <button type="button" class="af-chip" data-preset="custom">Custom</button>
    </div>
    <div class="af-custom" data-custom hidden>
        <input type="date" name="from" class="form-control" aria-label="From date" />
        <span class="text-muted-alto">to</span>
        <input type="date" name="to" class="form-control" aria-label="To date" />
    </div>
    <a class="btn btn-alto-ghost btn-sm af-csv" data-csv href="@Url.Action("ActivityCsv", "Accounts", new { id = Model.Account.Id })"><i class="bi bi-download me-1"></i>CSV</a>
</form>
