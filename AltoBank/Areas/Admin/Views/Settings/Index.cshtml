@model SettingsInput
@{
    var lines = (TempData["InterestLines"] as string)?.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                .Select(l => l.Split('|')).Where(p => p.Length == 2).ToList();
    var runInterest = new ConfirmModalViewModel("interestRunModal", "Run monthly interest",
        $"One month of interest at the current savings APY ({Model.SavingsApyPercent:0.00}%) will be credited to EVERY active savings account with a balance, as \"Interest\" transactions. You'll see a summary of accounts credited and the total paid.",
        Url.Action("RunInterest")!, "Run interest now", "primary");
}

@if (lines?.Any() == true)
{
    <div class="admin-card mb-3" style="border-color: rgba(46,242,176,.45)">
        <h2 class="h6"><i class="bi bi-percent me-1 text-success-alto"></i>Monthly interest summary</h2>
        <table class="table admin-table mb-0">
            <thead><tr><th>Account</th><th class="text-end">Interest paid</th></tr></thead>
            <tbody>@foreach (var p in lines) { <tr><td>@p[0]</td><td class="text-end amount-credit">@p[1]</td></tr> }</tbody>
        </table>
    </div>
}

<div class="row g-3">
    <div class="col-xl-7">
        <div class="admin-card">
            <h2 class="h6 mb-3">Bank settings</h2>
            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger-alto mb-2"></div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="SavingsApyPercent" class="form-label"></label>
                        <div class="input-group"><input asp-for="SavingsApyPercent" class="form-control" type="number" step="0.01" min="0" max="20" /><span class="input-group-text">%</span></div>
                        <span asp-validation-for="SavingsApyPercent" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="CheckingApyPercent" class="form-label"></label>
                        <div class="input-group"><input asp-for="CheckingApyPercent" class="form-control" type="number" step="0.01" min="0" max="20" /><span class="input-group-text">%</span></div>
                        <span asp-validation-for="CheckingApyPercent" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="DefaultDailyTransferLimit" class="form-label"></label>
                        <div class="input-group"><span class="input-group-text">$</span><input asp-for="DefaultDailyTransferLimit" class="form-control" type="number" step="0.01" min="0" /></div>
                        <span asp-validation-for="DefaultDailyTransferLimit" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LargeTransactionThreshold" class="form-label"></label>
                        <div class="input-group"><span class="input-group-text">$</span><input asp-for="LargeTransactionThreshold" class="form-control" type="number" step="0.01" min="1" /></div>
                        <span asp-validation-for="LargeTransactionThreshold" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="MobileDepositPerCheckLimit" class="form-label"></label>
                        <div class="input-group"><span class="input-group-text">$</span><input asp-for="MobileDepositPerCheckLimit" class="form-control" type="number" step="0.01" min="1" /></div>
                        <span asp-validation-for="MobileDepositPerCheckLimit" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="MobileDepositDailyLimit" class="form-label"></label>
                        <div class="input-group"><span class="input-group-text">$</span><input asp-for="MobileDepositDailyLimit" class="form-control" type="number" step="0.01" min="1" /></div>
                        <span asp-validation-for="MobileDepositDailyLimit" class="field-validation-error"></span>
                        <div class="small text-muted-alto">Per customer, per bank day. Pending and approved checks count.</div>
                    </div>
                    <div class="col-12"><h3 class="h6 mt-2 mb-0">Alto Peak credit card</h3></div>
                    @foreach (var (field, prefix, suffix, step) in new[] {
                        ("CardPurchaseAprPercent", "", "%", "0.01"), ("CardLateFee", "$", "", "0.01"), ("CardCashBackPercent", "", "%", "0.01"),
                        ("CardMinimumPaymentFloor", "$", "", "0.01"), ("CardMinimumPaymentPercent", "", "%", "0.01") })
                    {
                        <div class="col-sm-6 col-lg-4">
                            <label for="@field" class="form-label">@Html.DisplayName(field)</label>
                            <div class="input-group">
                                @if (prefix != "") { <span class="input-group-text">@prefix</span> }
                                <input id="@field" name="@field" class="form-control" type="number" step="@step" min="0"
                                       value="@(((decimal?)Model.GetType().GetProperty(field)!.GetValue(Model))?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                                @if (suffix != "") { <span class="input-group-text">@suffix</span> }
                            </div>
                            <span class="field-validation-error" data-valmsg-for="@field"></span>
                        </div>
                    }
                    <div class="col-12 small text-muted-alto">Interest uses the daily balance method and is only charged when the last statement wasn't paid in full by its due date. The minimum payment is the larger of the two amounts (or the whole balance if that's less).</div>
                    <div class="col-12"><h3 class="h6 mt-2 mb-0">Loans</h3></div>
                    @foreach (var (field, prefix, suffix, step) in new[] {
                        ("LoanRateTierA", "", "%", "0.01"), ("LoanRateTierB", "", "%", "0.01"), ("LoanRateTierC", "", "%", "0.01"), ("LoanRateTierD", "", "%", "0.01"),
                        ("AutoLoanRateDiscount", "", "pts", "0.01"), ("LoanReviewAmount", "$", "", "1"), ("LoanLateFee", "$", "", "0.01"), ("LoanGraceDays", "", "days", "1") })
                    {
                        var raw = Model.GetType().GetProperty(field)!.GetValue(Model);
                        <div class="col-sm-6 col-lg-3">
                            <label for="@field" class="form-label">@Html.DisplayName(field)</label>
                            <div class="input-group">
                                @if (prefix != "") { <span class="input-group-text">@prefix</span> }
                                <input id="@field" name="@field" class="form-control" type="number" step="@step" min="0"
                                       value="@(raw is IFormattable fv ? fv.ToString(null, System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                @if (suffix != "") { <span class="input-group-text">@suffix</span> }
                            </div>
                            <span class="field-validation-error" data-valmsg-for="@field"></span>
                        </div>
                    }
                    <div class="col-12 small text-muted-alto">The simulated decision puts each application in a tier by income (one tier better for established customers). Auto loans get the discount off their tier. Loans at or above the review amount, tier D, or with a payment over 15% of income wait for staff review. A payment more than the grace days late is overdue and gets the late fee.</div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="ProvisionalCreditOnDisputes" class="form-check-input" role="switch" />
                            <label asp-for="ProvisionalCreditOnDisputes" class="form-check-label"></label>
                        </div>
                        <div class="small text-muted-alto">ON: when a customer files a dispute, the amount is credited right away and taken back if the dispute is denied (even if that overdraws the account). Applies to disputes filed after the change.</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="AutoApproveApplications" class="form-check-input" role="switch" />
                            <label asp-for="AutoApproveApplications" class="form-check-label"></label>
                        </div>
                        <div class="small text-muted-alto">ON: valid applications are approved instantly. OFF: they wait as Pending for review in Applications.</div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Reason" class="form-label">Reason for this change *</label>
                        <input asp-for="Reason" class="form-control" placeholder="Saved in the audit log" />
                        <span asp-validation-for="Reason" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
                    <button type="submit" class="btn btn-admin"><i class="bi bi-save me-1"></i>Save settings</button>
                    <span class="small text-muted-alto">Last changed @(Model.UpdatedAt == null ? "never" : BankTime.ToLocal(Model.UpdatedAt.Value).ToString("MMM d, yyyy h:mm tt") + " by " + Model.UpdatedBy)</span>
                </div>
            </form>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="admin-card">
            <h2 class="h6"><i class="bi bi-percent me-1"></i>Monthly interest</h2>
            <p class="small text-muted-alto">Posts one month of interest (APY ÷ 12) to every active savings account in a single database transaction, with one audit log entry.</p>
            <button class="btn btn-admin" data-bs-toggle="modal" data-bs-target="#interestRunModal">Run monthly interest…</button>
        </div>
    </div>
</div>

<partial name="_ConfirmModal" model="runInterest" />

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
