@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="auth-wrap">
    <div class="glass auth-card">
        <h2 class="mb-1">Welcome back</h2>
        <p class="text-muted-alto mb-4">Log in to your Alto account.</p>

        @* DEMO MODE: AuthController sets ViewData["ShowDemo"] only in the Development environment. *@
        @if (ViewData["ShowDemo"] is true)
        {
            <div class="demo-box mb-4">
                <div class="small text-muted-alto mb-2"><i class="bi bi-lightning-charge me-1"></i>Try the demo (Development only)</div>
                <div class="d-flex flex-wrap gap-2">
                    <form asp-action="DemoLogin" method="post" class="flex-fill">
                        <input type="hidden" name="who" value="customer" />
                        <button type="submit" class="btn btn-alto-outline w-100"><i class="bi bi-person me-1"></i>Demo Customer</button>
                    </form>
                    <form asp-action="DemoLogin" method="post" class="flex-fill">
                        <input type="hidden" name="who" value="admin" />
                        <button type="submit" class="btn btn-alto-ghost w-100"><i class="bi bi-speedometer2 me-1"></i>Demo Admin</button>
                    </form>
                </div>
                <div class="small text-muted-alto mt-2">
                    Or log in with <code>demo@@altobank.com</code> / <code>Demo123!</code>
                </div>
            </div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-muted-alto"></label>
            </div>
            <button type="submit" class="btn btn-alto w-100 py-2">Log In</button>
        </form>

        <p class="text-center text-muted-alto mt-4 mb-0">
            New to Alto? <a asp-action="Register">Open an account</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
