@model Account
@* Reusable account summary card (used on the Dashboard and Accounts pages).
   Shows the nickname when set, and a progress bar for savings accounts with a goal. *@
<div class="glass glass-hover account-card @(Model.AccountType == AccountType.Savings ? "savings" : "")">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="account-type">@Model.AccountType</span>
        <span class="account-digits">•••• @Model.Last4</span>
    </div>
    @* The account name links to the Account Details page at /accounts/{id}. *@
    <a class="account-name account-link" asp-controller="Accounts" asp-action="Details" asp-route-id="@Model.Id">@Model.DisplayName <i class="bi bi-chevron-right small"></i></a>
    <div class="account-balance"><money amount="@Model.Balance" /></div>
    <div class="text-muted-alto small mb-3">Available balance</div>

    @if (Model.GoalAmount is decimal goal && goal > 0)
    {
        var pct = Math.Min(100m, Model.Balance / goal * 100m);
        <div class="goal mb-3">
            <div class="d-flex justify-content-between small mb-1">
                <span><i class="bi bi-bullseye me-1"></i>@(Model.GoalName ?? "Savings goal")</span>
                <span class="text-muted-alto">@pct.ToString("0")% of @goal.ToString("C0")</span>
            </div>
            <div class="progress alto-progress" role="progressbar" aria-valuenow="@pct.ToString("0")" aria-valuemin="0" aria-valuemax="100" aria-label="Goal progress">
                <div class="progress-bar" style="width: @pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
    }

    <div class="card-actions d-flex flex-wrap gap-2">
        <a class="btn btn-alto-outline btn-sm" asp-controller="Accounts" asp-action="Details" asp-route-id="@Model.Id">Details</a>
        <a class="btn btn-alto-ghost btn-sm" asp-controller="Transactions" asp-action="Deposit" asp-route-accountId="@Model.Id">Deposit</a>
        <a class="btn btn-alto-ghost btn-sm" asp-controller="Transactions" asp-action="Withdraw" asp-route-accountId="@Model.Id">Withdraw</a>
        <a class="btn btn-alto-ghost btn-sm" asp-controller="Transactions" asp-action="Transfer" asp-route-fromAccountId="@Model.Id">Transfer</a>
    </div>
</div>
